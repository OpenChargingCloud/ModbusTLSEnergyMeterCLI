<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>cloud.charging.open.EnergyMeters.ModbusTLS.CLI</RootNamespace>
    <AssemblyName>ModbusTLSEnergyMeterCLI</AssemblyName>
    <!-- Not invariant. ChargyCore names a time zone by its IANA identifier in a
         static field ("Europe/Berlin"), and in invariant globalization that
         lookup throws while the type is being initialised - which takes the
         whole library down, not only the path that wanted a time zone. The
         meter formats its own numbers and timestamps with the invariant culture
         explicitly, so what this gives up is nothing it was relying on. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\ModbusTLSEnergyMeter\ModbusTLSEnergyMeter\ModbusTLSEnergyMeter.csproj" />
    <ProjectReference Include="..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\libs\Norn\Norn\Norn.csproj" />
    <ProjectReference Include="..\libs\Styx\Styx\Styx.csproj" />
  </ItemGroup>

</Project>
